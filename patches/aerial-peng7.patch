@@ -0,0 +1,26 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="beginner_title">Setup and recovery</string>
+    <string name="beginner_intro">A guided start for your TV. Use the remote to check the device, authorize Home Guard and open the desktop.</string>
+    <string name="beginner_compatibility">Device information is not a compatibility guarantee. Startup and standby behavior depend on the TV firmware. Video services need their own compatible apps and accounts.</string>
+    <string name="beginner_detected">1 · Check your TV</string>
+    <string name="beginner_remote">Use Up and Down to move, OK to select, and Back to return. If an authorization page is unavailable, you can try the desktop first.</string>
+    <string name="beginner_continue">Continue: Home Guard</string>
+    <string name="beginner_exit">Exit setup</string>
+    <string name="beginner_guard_title">2 · Home Guard · on by default</string>
+    <string name="beginner_guard_body">Enable Aerial in the system accessibility page, then return here. Home Guard can observe the interface and handle the Home key. The system needs your confirmation.</string>
+    <string name="beginner_authorized">Accessibility authorization is enabled. Finish setup to enter the desktop. Startup and wake behavior still need a test on this TV.</string>
+    <string name="beginner_authorize">Open authorization settings</string>
+    <string name="beginner_enter">Finish and open desktop</string>
+    <string name="beginner_try_without">Try without Home Guard</string>
+    <string name="beginner_missing_page">This firmware has no accessible authorization page. Home Guard may require computer-assisted setup. You can still try the desktop.</string>
+    <string name="beginner_recovery">Turn off and restore</string>
+    <string name="beginner_recovery_body">Turn off our Home Guard first. If you changed the default home or startup app, select the original one in TV settings. Other accessibility services stay enabled.</string>
+    <string name="beginner_disable">Turn off Home Guard</string>
+    <string name="beginner_disabled">Home Guard is off and will not be restored automatically.</string>
+    <string name="beginner_stock_home">Open original desktop</string>
+    <string name="beginner_home_settings">Choose default desktop</string>
+    <string name="beginner_tv_settings">Open TV settings</string>
+    <string name="beginner_back">Back</string>
+    <string name="beginner_open_failed">This page could not be opened. Use TV settings instead.</string>
+</resources>
