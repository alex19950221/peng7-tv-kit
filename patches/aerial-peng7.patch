+</resources>
diff --git a/app/src/main/res/values-ru/beginner.xml b/app/src/main/res/values-ru/beginner.xml
new file mode 100644
index 0000000000000000000000000000000000000000..d424adb25b18f1478c6775af8ce52d8f1f2e5a6f
--- /dev/null
