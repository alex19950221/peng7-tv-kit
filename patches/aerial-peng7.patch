@@ -0,0 +1,108 @@
+package app.orchard.tv.ui.control
+
+import android.view.KeyEvent
+import android.view.View
+import androidx.activity.ComponentActivity
+import androidx.activity.compose.setContent
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.layout.size
+import androidx.compose.foundation.layout.width
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalView
+import androidx.compose.ui.test.assertIsDisplayed
+import androidx.compose.ui.test.getUnclippedBoundsInRoot
+import androidx.compose.ui.test.junit4.createEmptyComposeRule
+import androidx.compose.ui.test.onNodeWithText
+import androidx.compose.ui.unit.dp
+import app.orchard.tv.R
+import app.orchard.tv.system.MediaAction
+import app.orchard.tv.system.MediaAppsStatus
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.android.controller.ActivityController
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28], qualifiers = "zh-rCN-w960dp-h540dp-land-xhdpi")
+class MediaToolsPageTest {
+    @get:Rule val compose = createEmptyComposeRule()
+    private var host: ActivityController<ComponentActivity>? = null
+    private lateinit var view: View
+    private val actions = mutableListOf<MediaAction>()
+    private var back = 0
+    private fun text(id: Int) = RuntimeEnvironment.getApplication().getString(id)
+
+    @After fun close() { compose.runOnUiThread { host?.close() } }
+
+    @Test fun remoteCanReachEachCommandExactlyOnce() {
+        mount()
+        for (action in MediaAction.entries) {
+            tap(KeyEvent.KEYCODE_DPAD_DOWN)
+            tap(KeyEvent.KEYCODE_DPAD_CENTER)
+            assertEquals(action, actions.last())
+        }
+        assertEquals(MediaAction.entries.toList(), actions)
+        repeat(4) { tap(KeyEvent.KEYCODE_DPAD_UP) }
+        tap(KeyEvent.KEYCODE_DPAD_CENTER)
+        assertEquals(1, back)
+    }
+
+    @Test fun chineseLabelsAndSetupHintFitTheTvPanel() {
+        mount()
+        for (id in listOf(R.string.media_tools_title, R.string.media_apple_open,
+            R.string.media_clash_open, R.string.media_clash_start, R.string.media_clash_stop,
+            R.string.media_first_connection)) {
+            val node = compose.onNodeWithText(text(id)).assertIsDisplayed()
+            val bounds = node.getUnclippedBoundsInRoot()
+            assertTrue("$id below screen: $bounds", bounds.bottom <= 516.dp)
+            assertTrue("$id outside screen: $bounds", bounds.left >= 0.dp && bounds.right <= 936.dp)
+        }
+    }
+
+    @Test fun vpnStatusDoesNotClaimClashIsConnected() {
+        mount(vpnActive = true)
+        compose.onNodeWithText(text(R.string.media_vpn_active)).assertIsDisplayed()
+        // Merely seeing a VPN must not dispatch a command or claim Apple TV is playable.
+        assertTrue(actions.isEmpty())
+    }
+
+    private fun mount(vpnActive: Boolean = false) {
+        compose.mainClock.autoAdvance = false
+        compose.runOnUiThread {
+            val controller = Robolectric.buildActivity(ComponentActivity::class.java)
+            host = controller
+            controller.setup()
+            controller.get().setContent {
+                view = LocalView.current
+                Box(Modifier.size(960.dp, 540.dp).padding(top = 24.dp, end = 32.dp), contentAlignment = Alignment.TopEnd) {
+                    Box(Modifier.width(300.dp).padding(16.dp)) {
+                        MediaToolsContent(MediaAppsStatus(true, true), vpnActive, true,
+                            onBack = { back++ }, onAction = { actions += it })
+                    }
+                }
+            }
+            controller.windowFocusChanged(true)
+        }
+        settle()
+    }
+
+    private fun settle() {
+        repeat(30) { compose.mainClock.advanceTimeByFrame(); compose.waitForIdle() }
+    }
+
+    private fun tap(code: Int) {
+        compose.runOnUiThread {
+            view.dispatchKeyEvent(KeyEvent(KeyEvent.ACTION_DOWN, code))
+            view.dispatchKeyEvent(KeyEvent(KeyEvent.ACTION_UP, code))
+        }
+        settle()
+    }
+}
