--- /dev/null
+++ b/app/src/main/java/app/orchard/tv/system/MediaShortcuts.kt
@@ -0,0 +1,64 @@
+package app.orchard.tv.system
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+
+enum class MediaAction { AppleTv, Clash, StartClash, StopClash }
+
+data class MediaAppsStatus(val appleTv: Boolean = false, val clash: Boolean = false)
+
+/** Only talks to installed apps through their public activities. No profiles or credentials. */
+object MediaShortcuts {
+    const val CLASH_PACKAGE = "com.github.metacubex.clash.meta"
+    const val CLASH_CONTROL = "com.github.kr328.clash.ExternalControlActivity"
+    private val applePackages = listOf("com.apple.atve.androidtv.appletv", "com.apple.atve.sony.appletv")
+
+    fun isMediaIntent(intent: Intent): Boolean = intent.component?.packageName.let {
+        it == CLASH_PACKAGE || it in applePackages
+    }
+
+    fun status(context: Context) = MediaAppsStatus(
+        appleTv = intent(context, MediaAction.AppleTv) != null,
+        clash = intent(context, MediaAction.Clash) != null,
+    )
+
+    fun intent(context: Context, action: MediaAction): Intent? = when (action) {
+        MediaAction.AppleTv -> applePackages.firstNotNullOfOrNull { launch(context, it) }
+        MediaAction.Clash -> launch(context, CLASH_PACKAGE)
+        MediaAction.StartClash, MediaAction.StopClash -> {
+            // Separate commands, never a toggle derived from Android's generic VPN indicator:
+            // another VPN may own that indicator, or the status may have changed since rendering.
+            val command = if (action == MediaAction.StartClash) "START_CLASH" else "STOP_CLASH"
+            Intent("$CLASH_PACKAGE.action.$command")
+                .setComponent(ComponentName(CLASH_PACKAGE, CLASH_CONTROL))
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                .takeIf { usable(context, it) }
+        }
+    }
+
+    private fun launch(context: Context, packageName: String): Intent? {
+        val pm = context.packageManager
+        // Prefer the remote-friendly TV entry, fall back to the regular launcher when available.
+        val tv = runCatching { pm.getLeanbackLaunchIntentForPackage(packageName) }.getOrNull()
+        if (tv != null && usable(context, tv)) return tv
+        return runCatching { pm.getLaunchIntentForPackage(packageName) }.getOrNull()
+            ?.takeIf { usable(context, it) }
+    }
+
+    @Suppress("DEPRECATION")
+    private fun usable(context: Context, intent: Intent): Boolean = runCatching {
+        val pm = context.packageManager
+        val component = intent.component ?: pm.resolveActivity(intent, 0)?.activityInfo
+            ?.let { ComponentName(it.packageName, it.name) } ?: return false
+        val info = pm.getActivityInfo(component, 0)
+        fun disabled(state: Int) = state == PackageManager.COMPONENT_ENABLED_STATE_DISABLED ||
+            state == PackageManager.COMPONENT_ENABLED_STATE_DISABLED_USER ||
+            state == PackageManager.COMPONENT_ENABLED_STATE_DISABLED_UNTIL_USED
+        info.enabled && info.applicationInfo.enabled && info.exported &&
+            !disabled(pm.getApplicationEnabledSetting(component.packageName)) &&
+            !disabled(pm.getComponentEnabledSetting(component)) &&
+            (info.permission.isNullOrEmpty() || pm.checkPermission(info.permission, context.packageName) == PackageManager.PERMISSION_GRANTED)
+    }.getOrDefault(false)
+}
