+    <string name="beginner_intro">跟着引导检查设备、授权桌面守护，再进入桌面。全程可用遥控器操作。</string>
+    <string name="beginner_compatibility">读取到设备信息不等于已经适配。开机和待机恢复仍受厂商固件影响；视频服务需使用各自兼容的客户端和账号。</string>
+    <string name="beginner_detected">1 · 检查你的电视</string>
+    <string name="beginner_remote">上下键移动，确认键选择，返回键退回上一步。没有授权入口时，可以先体验桌面。</string>
+    <string name="beginner_continue">下一步：桌面守护</string>
+    <string name="beginner_exit">退出引导</string>
+    <string name="beginner_guard_title">2 · 桌面守护 · 默认启用</string>
+    <string name="beginner_guard_body">在系统无障碍页面启用 Aerial，然后返回这里。守护可以观察界面并处理主页键，需由你在系统页面确认授权。</string>
+    <string name="beginner_authorized">系统无障碍授权已开启，可完成设置进入桌面。本机的开机、待机恢复仍需实际测试。</string>
+    <string name="beginner_authorize">前往系统授权</string>
+    <string name="beginner_enter">完成设置，进入桌面</string>
+    <string name="beginner_try_without">暂不启用，先体验桌面</string>
+    <string name="beginner_missing_page">此固件没有可打开的授权页面，桌面守护可能需要电脑辅助配置。你仍可先体验桌面。</string>
+    <string name="beginner_recovery">关闭守护与恢复</string>
+    <string name="beginner_recovery_body">先关闭本应用的桌面守护。如果改过默认桌面或开机应用，还需在电视设置中选回原桌面。其他无障碍服务会保留。</string>
+    <string name="beginner_disable">关闭桌面守护</string>
+    <string name="beginner_disabled">桌面守护已关闭，后续不会自动恢复开启。</string>
+    <string name="beginner_stock_home">打开原桌面</string>
+    <string name="beginner_home_settings">选择默认桌面</string>
+    <string name="beginner_tv_settings">打开电视设置</string>
+    <string name="beginner_back">返回上一步</string>
+    <string name="beginner_open_failed">无法打开此页面，请从电视设置中操作。</string>
+</resources>
