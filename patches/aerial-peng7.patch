diff --git a/app/src/test/java/app/orchard/tv/system/MediaShortcutsTest.kt b/app/src/test/java/app/orchard/tv/system/MediaShortcutsTest.kt
new file mode 100644
index 0000000..2f57277
--- /dev/null
+++ b/app/src/test/java/app/orchard/tv/system/MediaShortcutsTest.kt
@@ -0,0 +1,104 @@
+package app.orchard.tv.system
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.content.pm.PackageManager
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28])
+class MediaShortcutsTest {
+    private val context: Context = RuntimeEnvironment.getApplication()
+    private val pm = shadowOf(context.packageManager)
+    private val apple = "com.apple.atve.androidtv.appletv"
+    private val control = ComponentName(MediaShortcuts.CLASH_PACKAGE, MediaShortcuts.CLASH_CONTROL)
+
+    @Test fun missingClientsHaveNoActionOrFalseReadyStatus() {
+        for (action in MediaAction.entries) assertNull(MediaShortcuts.intent(context, action))
+        assertEquals(MediaAppsStatus(), MediaShortcuts.status(context))
+    }
+
+    @Test fun applePrefersItsTvEntryOverItsPhoneEntry() {
+        addLauncher(apple, "Phone", Intent.CATEGORY_LAUNCHER)
+        val tv = addLauncher(apple, "Tv", Intent.CATEGORY_LEANBACK_LAUNCHER)
+        assertEquals(tv, MediaShortcuts.intent(context, MediaAction.AppleTv)?.component)
+    }
+
+    @Test fun disabledTvEntryFallsBackToUsableRegularEntry() {
+        val regular = addLauncher(apple, "Regular", Intent.CATEGORY_LAUNCHER)
+        val tv = addLauncher(apple, "Tv", Intent.CATEGORY_LEANBACK_LAUNCHER)
+        context.packageManager.setComponentEnabledSetting(tv, PackageManager.COMPONENT_ENABLED_STATE_DISABLED, 0)
+        assertEquals(regular, MediaShortcuts.intent(context, MediaAction.AppleTv)?.component)
+    }
+
+    @Test fun existingSonyAppleTvVariantCanBeOpened() {
+        val tv = addLauncher("com.apple.atve.sony.appletv", "Tv", Intent.CATEGORY_LEANBACK_LAUNCHER)
+        assertEquals(tv, MediaShortcuts.intent(context, MediaAction.AppleTv)?.component)
+    }
+
+    @Test fun disabledApplicationIsNotReportedAsReady() {
+        addLauncher(MediaShortcuts.CLASH_PACKAGE, "Main", Intent.CATEGORY_LEANBACK_LAUNCHER)
+        context.packageManager.setApplicationEnabledSetting(MediaShortcuts.CLASH_PACKAGE, PackageManager.COMPONENT_ENABLED_STATE_DISABLED_USER, 0)
+        assertFalse(MediaShortcuts.status(context).clash)
+    }
+
+    @Test fun commandsAreExplicitAndIdempotentNotToggles() {
+        addControl()
+        for ((action, command) in listOf(MediaAction.StartClash to "START_CLASH", MediaAction.StopClash to "STOP_CLASH")) {
+            val intent = requireNotNull(MediaShortcuts.intent(context, action))
+            assertEquals(control, intent.component)
+            assertEquals("${MediaShortcuts.CLASH_PACKAGE}.action.$command", intent.action)
+            assertEquals(Intent.FLAG_ACTIVITY_NEW_TASK, intent.flags)
+            assertNull(intent.data)
+            assertNull(intent.extras)
+        }
+    }
+
+    @Test fun privateOrDisabledControlIsNeverInvoked() {
+        val info = addControl()
+        info.exported = false
+        assertNull(MediaShortcuts.intent(context, MediaAction.StartClash))
+        info.exported = true
+        context.packageManager.setComponentEnabledSetting(control, PackageManager.COMPONENT_ENABLED_STATE_DISABLED, 0)
+        assertNull(MediaShortcuts.intent(context, MediaAction.StopClash))
+    }
+
+    @Test fun permissionProtectedControlIsNotReportedAsUsable() {
+        addControl().permission = "test.permission.PRIVATE_CONTROL"
+        assertNull(MediaShortcuts.intent(context, MediaAction.StartClash))
+    }
+
+    @Test fun anUnrelatedHandlerCannotReceiveClashCommands() {
+        val component = addLauncher("test.other.vpn", "Control", Intent.CATEGORY_LAUNCHER)
+        pm.addIntentFilterForActivity(component, IntentFilter("${MediaShortcuts.CLASH_PACKAGE}.action.START_CLASH"))
+        assertNull(MediaShortcuts.intent(context, MediaAction.StartClash))
+    }
+
+    @Test fun aLaunchableClientWithoutControlApiStillOpensNormally() {
+        val component = addLauncher(MediaShortcuts.CLASH_PACKAGE, "Main", Intent.CATEGORY_LEANBACK_LAUNCHER)
+        assertTrue(MediaShortcuts.status(context).clash)
+        assertEquals(component, MediaShortcuts.intent(context, MediaAction.Clash)?.component)
+        assertNull(MediaShortcuts.intent(context, MediaAction.StartClash))
+    }
+
+    private fun addControl() = pm.addActivityIfNotPresent(control).apply {
+        enabled = true; exported = true; applicationInfo.enabled = true
+    }
+
+    private fun addLauncher(pkg: String, name: String, category: String): ComponentName {
+        val component = ComponentName(pkg, "$pkg.$name")
+        pm.addActivityIfNotPresent(component).apply {
+            enabled = true; exported = true; applicationInfo.enabled = true
+        }
+        pm.addIntentFilterForActivity(component, IntentFilter(Intent.ACTION_MAIN).apply { addCategory(category) })
+        return component
+    }
+}
diff --git a/app/src/test/java/app/orchard/tv/ui/control/MediaToolsPageTest.kt b/app/src/test/java/app/orchard/tv/ui/control/MediaToolsPageTest.kt
new file mode 100644
index 0000000..d54a806
--- /dev/null
+++ b/app/src/test/java/app/orchard/tv/ui/control/MediaToolsPageTest.kt
@@ -0,0 +1,108 @@
+package app.orchard.tv.ui.control
+
+import android.view.KeyEvent
+import android.view.View
+import androidx.activity.ComponentActivity
+import androidx.activity.compose.setContent
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.layout.size
+import androidx.compose.foundation.layout.width
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalView
+import androidx.compose.ui.test.assertIsDisplayed
+import androidx.compose.ui.test.getUnclippedBoundsInRoot
+import androidx.compose.ui.test.junit4.createEmptyComposeRule
+import androidx.compose.ui.test.onNodeWithText
+import androidx.compose.ui.unit.dp
+import app.orchard.tv.R
+import app.orchard.tv.system.MediaAction
+import app.orchard.tv.system.MediaAppsStatus
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.android.controller.ActivityController
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28], qualifiers = "zh-rCN-w960dp-h540dp-land-xhdpi")
+class MediaToolsPageTest {
+    @get:Rule val compose = createEmptyComposeRule()
+    private var host: ActivityController<ComponentActivity>? = null
+    private lateinit var view: View
+    private val actions = mutableListOf<MediaAction>()
+    private var back = 0
+    private fun text(id: Int) = RuntimeEnvironment.getApplication().getString(id)
+
+    @After fun close() { compose.runOnUiThread { host?.close() } }
+
+    @Test fun remoteCanReachEachCommandExactlyOnce() {
+        mount()
+        for (action in MediaAction.entries) {
+            tap(KeyEvent.KEYCODE_DPAD_DOWN)
+            tap(KeyEvent.KEYCODE_DPAD_CENTER)
+            assertEquals(action, actions.last())
+        }
+        assertEquals(MediaAction.entries.toList(), actions)
+        repeat(4) { tap(KeyEvent.KEYCODE_DPAD_UP) }
+        tap(KeyEvent.KEYCODE_DPAD_CENTER)
+        assertEquals(1, back)
+    }
+
+    @Test fun chineseLabelsAndSetupHintFitTheTvPanel() {
+        mount()
+        for (id in listOf(R.string.media_tools_title, R.string.media_apple_open,
+            R.string.media_clash_open, R.string.media_clash_start, R.string.media_clash_stop,
+            R.string.media_first_connection)) {
+            val node = compose.onNodeWithText(text(id)).assertIsDisplayed()
+            val bounds = node.getUnclippedBoundsInRoot()
+            assertTrue("$id below screen: $bounds", bounds.bottom <= 516.dp)
+            assertTrue("$id outside screen: $bounds", bounds.left >= 0.dp && bounds.right <= 936.dp)
+        }
+    }
+
+    @Test fun vpnStatusDoesNotClaimClashIsConnected() {
+        mount(vpnActive = true)
+        compose.onNodeWithText(text(R.string.media_vpn_active)).assertIsDisplayed()
+        // Merely seeing a VPN must not dispatch a command or claim Apple TV is playable.
+        assertTrue(actions.isEmpty())
+    }
+
+    private fun mount(vpnActive: Boolean = false) {
+        compose.mainClock.autoAdvance = false
+        compose.runOnUiThread {
+            val controller = Robolectric.buildActivity(ComponentActivity::class.java)
+            host = controller
+            controller.setup()
+            controller.get().setContent {
+                view = LocalView.current
+                Box(Modifier.size(960.dp, 540.dp).padding(top = 24.dp, end = 32.dp), contentAlignment = Alignment.TopEnd) {
+                    Box(Modifier.width(300.dp).padding(16.dp)) {
+                        MediaToolsContent(MediaAppsStatus(true, true), vpnActive, true,
+                            onBack = { back++ }, onAction = { actions += it })
+                    }
+                }
+            }
+            controller.windowFocusChanged(true)
+        }
+        settle()
+    }
+
+    private fun settle() {
+        repeat(30) { compose.mainClock.advanceTimeByFrame(); compose.waitForIdle() }
+    }
+
+    private fun tap(code: Int) {
+        compose.runOnUiThread {
+            view.dispatchKeyEvent(KeyEvent(KeyEvent.ACTION_DOWN, code))
+            view.dispatchKeyEvent(KeyEvent(KeyEvent.ACTION_UP, code))
+        }
+        settle()
+    }
+}
