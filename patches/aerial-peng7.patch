@@ -0,0 +1,87 @@
+package app.orchard.tv.settings
+
+import android.Manifest
+import android.content.ComponentName
+import android.content.Context
+import android.content.pm.PackageManager
+import android.os.UserManager
+import android.provider.Settings
+import app.orchard.tv.guard.GuardSetup
+import app.orchard.tv.guard.HomeGuardService
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [23, 26, 28])
+class BeginnerSetupTest {
+    private val context get() = RuntimeEnvironment.getApplication() as Context
+    private val service get() = ComponentName(context, HomeGuardService::class.java)
+    private val other = "test.assistant/test.assistant.Service"
+
+    @Before fun reset() {
+        context.getSharedPreferences("beginner_setup", Context.MODE_PRIVATE).edit().clear().commit()
+        context.packageManager.setComponentEnabledSetting(service, PackageManager.COMPONENT_ENABLED_STATE_DEFAULT, PackageManager.DONT_KILL_APP)
+        Settings.Secure.putString(context.contentResolver, Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES, other)
+        Settings.Secure.putInt(context.contentResolver, Settings.Secure.ACCESSIBILITY_ENABLED, 1)
+        shadowOf(context.getSystemService(Context.USER_SERVICE) as UserManager).setUserUnlocked(true)
+    }
+
+    @Test fun defaultIsRequestedButNeverAuthorizedByTheWizard() {
+        shadowOf(RuntimeEnvironment.getApplication()).grantPermissions(Manifest.permission.WRITE_SECURE_SETTINGS)
+        assertTrue(BeginnerSetup.guardRequested(context))
+        assertTrue(BeginnerSetup.needsGuide(context))
+        assertFalse(BeginnerSetup.mayRestoreGuard(context))
+        assertFalse(GuardSetup.ensureEnabled(context))
+        assertEquals(other, services())
+    }
+
+    @Test fun completionRequiresActualSystemAuthorization() {
+        assertThrows(IllegalStateException::class.java) { BeginnerSetup.finish(context) }
+        assertFalse(BeginnerSetup.completed(context))
+    }
+
+    @Test fun successfulCompletionPreservesOtherServices() {
+        authorize()
+        BeginnerSetup.finish(context)
+        assertTrue(BeginnerSetup.completed(context))
+        assertTrue(BeginnerSetup.mayRestoreGuard(context))
+        assertEquals("$other:${service.flattenToString()}", services())
+    }
+
+    @Test fun disablingPersistsAndDoesNotRewriteGlobalAccessibility() {
+        authorize(); BeginnerSetup.finish(context)
+        val before = services()
+        BeginnerSetup.disableGuard(context)
+        assertFalse(BeginnerSetup.authorized(context))
+        assertFalse(BeginnerSetup.mayRestoreGuard(context))
+        assertFalse(GuardSetup.ensureEnabled(context))
+        assertFalse(GuardSetup.startAfterStopOverStock(context))
+        assertEquals(PackageManager.COMPONENT_ENABLED_STATE_DISABLED, context.packageManager.getComponentEnabledSetting(service))
+        assertEquals(before, services())
+        assertEquals(1, Settings.Secure.getInt(context.contentResolver, Settings.Secure.ACCESSIBILITY_ENABLED))
+        assertFalse(context.getSharedPreferences("beginner_setup", 0).getBoolean("guard_requested", true))
+    }
+
+    @Test fun preparingAuthorizationDoesNotGrantThePermission() {
+        BeginnerSetup.disableGuard(context)
+        BeginnerSetup.prepareGuard(context)
+        assertTrue(BeginnerSetup.guardRequested(context))
+        assertFalse(BeginnerSetup.authorized(context))
+        assertEquals(other, services())
+    }
+
+    @Test fun systemDisabledAccessibilityIsNotReportedAsAuthorized() {
+        authorize()
+        Settings.Secure.putInt(context.contentResolver, Settings.Secure.ACCESSIBILITY_ENABLED, 0)
+        assertFalse(BeginnerSetup.authorized(context))
+    }
+
+    private fun services() = Settings.Secure.getString(context.contentResolver, Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES)
+    private fun authorize() = Settings.Secure.putString(context.contentResolver, Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES, "$other:${service.flattenToString()}")
+}
