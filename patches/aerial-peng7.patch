@@ -0,0 +1,102 @@
+package app.orchard.tv
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.pm.PackageManager
+import android.provider.Settings
+import android.view.KeyEvent
+import androidx.compose.ui.test.assertIsDisplayed
+import androidx.compose.ui.test.junit4.createEmptyComposeRule
+import androidx.compose.ui.test.onNodeWithText
+import app.orchard.tv.guard.HomeGuardService
+import app.orchard.tv.settings.BeginnerSetup
+import app.orchard.tv.settings.AerialSettings
+import app.orchard.tv.system.SystemProbe
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.android.controller.ActivityController
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28], qualifiers = "zh-rCN-w960dp-h540dp-land-mdpi")
+class BeginnerActivityTest {
+    @get:Rule val compose = createEmptyComposeRule()
+    private var host: ActivityController<BeginnerActivity>? = null
+    private val app get() = RuntimeEnvironment.getApplication()
+    private fun text(id: Int) = app.getString(id)
+
+    @Before fun reset() {
+        AerialSettings.init(app)
+        AerialSettings.choosePin(null)
+        app.getSharedPreferences("beginner_setup", Context.MODE_PRIVATE).edit().clear().commit()
+        app.packageManager.setComponentEnabledSetting(ComponentName(app, HomeGuardService::class.java),
+            PackageManager.COMPONENT_ENABLED_STATE_DEFAULT, PackageManager.DONT_KILL_APP)
+        Settings.Secure.putString(app.contentResolver, Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES, "")
+        Settings.Secure.putInt(app.contentResolver, Settings.Secure.ACCESSIBILITY_ENABLED, 1)
+    }
+    @After fun close() { compose.runOnUiThread { host?.close() } }
+
+    @Test fun remoteOpensDefaultGuardStepWithoutGrantingPermission() {
+        mount()
+        compose.onNodeWithText(text(R.string.beginner_detected)).assertIsDisplayed()
+        tap(KeyEvent.KEYCODE_DPAD_CENTER)
+        compose.onNodeWithText(text(R.string.beginner_guard_title)).assertIsDisplayed()
+        assertTrue(BeginnerSetup.guardRequested(app))
+        assertFalse(BeginnerSetup.authorized(app))
+        assertFalse(BeginnerSetup.completed(app))
+    }
+
+    @Test fun remoteCanExplicitlySkipAndTheChoicePersists() {
+        mount(); tap(KeyEvent.KEYCODE_DPAD_CENTER)
+        if (SystemProbe.guardSettingsIntent(app) != null) tap(KeyEvent.KEYCODE_DPAD_DOWN)
+        tap(KeyEvent.KEYCODE_DPAD_CENTER)
+        assertTrue(BeginnerSetup.completed(app))
+        assertFalse(BeginnerSetup.guardRequested(app))
+        assertFalse(BeginnerSetup.mayRestoreGuard(app))
+    }
+
+    @Test fun authorizedUserCanFinishWithTheRemote() {
+        Settings.Secure.putString(app.contentResolver, Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES,
+            ComponentName(app, HomeGuardService::class.java).flattenToString())
+        mount(); tap(KeyEvent.KEYCODE_DPAD_CENTER)
+        compose.onNodeWithText(text(R.string.beginner_enter)).assertIsDisplayed()
+        tap(KeyEvent.KEYCODE_DPAD_CENTER)
+        assertTrue(BeginnerSetup.completed(app))
+        assertTrue(BeginnerSetup.guardRequested(app))
+    }
+
+    @Test fun anExistingParentPinCannotBeBypassedThroughRecovery() {
+        AerialSettings.choosePin("2468")
+        AerialSettings.relock()
+        org.robolectric.shadows.ShadowSystemClock.advanceBy(java.time.Duration.ofSeconds(1))
+        assertTrue(AerialSettings.locked)
+        compose.runOnUiThread { host = Robolectric.buildActivity(BeginnerActivity::class.java).setup() }
+        assertTrue(host!!.get().isFinishing)
+        assertFalse(BeginnerSetup.completed(app))
+    }
+
+    private fun mount() {
+        compose.mainClock.autoAdvance = false
+        compose.runOnUiThread {
+            host = Robolectric.buildActivity(BeginnerActivity::class.java).setup()
+            host!!.windowFocusChanged(true)
+        }
+        settle()
+    }
+    private fun settle() { repeat(20) { compose.mainClock.advanceTimeByFrame(); compose.waitForIdle() } }
+    private fun tap(code: Int) {
+        compose.runOnUiThread {
+            val view = host!!.get().window.decorView
+            view.dispatchKeyEvent(KeyEvent(KeyEvent.ACTION_DOWN, code))
+            view.dispatchKeyEvent(KeyEvent(KeyEvent.ACTION_UP, code))
+        }
+        settle()
+    }
+}
diff --git a/app/src/test/java/app/orchard/tv/settings/BeginnerSetupTest.kt b/app/src/test/java/app/orchard/tv/settings/BeginnerSetupTest.kt
