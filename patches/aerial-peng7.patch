+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.LifecycleEventObserver
+import androidx.lifecycle.compose.LocalLifecycleOwner
+import app.orchard.tv.CcPage
+import app.orchard.tv.HomeViewModel
+import app.orchard.tv.Overlay
+import app.orchard.tv.R
+import app.orchard.tv.settings.Restricted
+import app.orchard.tv.system.LaunchFallback
+import app.orchard.tv.system.MediaAction
+import app.orchard.tv.system.MediaAppsStatus
+import app.orchard.tv.system.MediaShortcuts
+import app.orchard.tv.ui.home.MenuRow
+import app.orchard.tv.ui.theme.Glyph
+import app.orchard.tv.ui.theme.Type
+
+@Composable
+fun MediaToolsPage(vm: HomeViewModel, takeFocus: Boolean, onOpen: (Intent) -> Unit) {
+    val context = LocalContext.current
+    val lifecycle = LocalLifecycleOwner.current.lifecycle
+    var status by remember { mutableStateOf(MediaShortcuts.status(context)) }
+    // Refresh when returning from the client or installer, without a permanent polling loop.
+    DisposableEffect(context, lifecycle) {
+        val observer = LifecycleEventObserver { _, event ->
+            if (event == Lifecycle.Event.ON_RESUME) status = MediaShortcuts.status(context)
+        }
+        lifecycle.addObserver(observer)
+        onDispose { lifecycle.removeObserver(observer) }
+    }
+    MediaToolsContent(status, vm.network.vpn, takeFocus,
+        onBack = { vm.overlay = Overlay.ControlCenter(CcPage.Main) },
+        onAction = { action ->
+            vm.whenUnlocked {
+                // Do not provide an alternate way around Kids and Elders mode's allowed apps.
+                if (!Restricted.active) {
+                    val intent = MediaShortcuts.intent(context, action)
+                    if (intent == null) {
+                        val message = when (action) {
+                            MediaAction.AppleTv -> R.string.media_apple_missing
+                            MediaAction.Clash -> R.string.media_clash_missing
+                            else -> R.string.media_control_missing
+                        }
+                        Toast.makeText(context, message, Toast.LENGTH_LONG).show()
+                    } else {
+                        LaunchFallback.arm(emptyList())
+                        onOpen(intent)
+                    }
+                }
+            }
+        },
+    )
+}
+
+@Composable
+internal fun MediaToolsContent(
+    status: MediaAppsStatus,
+    vpnActive: Boolean,
+    takeFocus: Boolean,
+    onBack: () -> Unit,
+    onAction: (MediaAction) -> Unit,
+) {
+    val first = remember { FocusRequester() }
+    LaunchedEffect(takeFocus) {
+        if (takeFocus) {
+            withFrameNanos { }
+            runCatching { first.requestFocus() }
+        }
+    }
+    Column(Modifier.heightIn(max = 460.dp).verticalScroll(rememberScrollState())) {
+        MenuRow(Glyph.ChevronLeft, stringResource(R.string.media_tools_title), onClick = onBack, focusRequester = first)
+        BasicText(
+            stringResource(if (vpnActive) R.string.media_vpn_active else R.string.media_vpn_inactive),
+            style = Type.Caption, modifier = Modifier.padding(horizontal = 14.dp, vertical = 8.dp),
+        )
+        MenuRow(Glyph.Play, stringResource(R.string.media_apple_open),
+            onClick = { onAction(MediaAction.AppleTv) },
+            trailing = stringResource(if (status.appleTv) R.string.media_ready else R.string.media_unavailable))
+        MenuRow(Glyph.Globe, stringResource(R.string.media_clash_open),
+            onClick = { onAction(MediaAction.Clash) },
+            trailing = stringResource(if (status.clash) R.string.media_ready else R.string.media_unavailable))
+        MenuRow(Glyph.Power, stringResource(R.string.media_clash_start), onClick = { onAction(MediaAction.StartClash) })
+        MenuRow(Glyph.Shield, stringResource(R.string.media_clash_stop), onClick = { onAction(MediaAction.StopClash) })
+        Spacer(Modifier.height(8.dp))
+        BasicText(stringResource(R.string.media_first_connection), style = Type.Caption,
+            modifier = Modifier.padding(horizontal = 14.dp))
+    }
+}
