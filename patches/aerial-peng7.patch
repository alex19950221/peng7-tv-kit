+package app.orchard.tv.update
+
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28])
+class LocalEditionTest {
+    @Test fun customBuildDoesNotOfferAnIncompatibleUpstreamUpdate() {
+        val context = RuntimeEnvironment.getApplication()
+        Updates.init(context)
+        Updates.checkIfStale(force = true)
+        assertNull(Updates.available)
+        assertFalse(Updates.canInstall(context))
+        assertEquals("local edition; manual updates", Updates.diagnostics())
+    }
+}
