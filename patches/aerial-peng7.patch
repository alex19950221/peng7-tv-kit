@@ -0,0 +1,104 @@
+package app.orchard.tv.system
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.content.pm.PackageManager
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28])
+class MediaShortcutsTest {
+    private val context: Context = RuntimeEnvironment.getApplication()
+    private val pm = shadowOf(context.packageManager)
+    private val apple = "com.apple.atve.androidtv.appletv"
+    private val control = ComponentName(MediaShortcuts.CLASH_PACKAGE, MediaShortcuts.CLASH_CONTROL)
+
+    @Test fun missingClientsHaveNoActionOrFalseReadyStatus() {
+        for (action in MediaAction.entries) assertNull(MediaShortcuts.intent(context, action))
+        assertEquals(MediaAppsStatus(), MediaShortcuts.status(context))
+    }
+
+    @Test fun applePrefersItsTvEntryOverItsPhoneEntry() {
+        addLauncher(apple, "Phone", Intent.CATEGORY_LAUNCHER)
+        val tv = addLauncher(apple, "Tv", Intent.CATEGORY_LEANBACK_LAUNCHER)
+        assertEquals(tv, MediaShortcuts.intent(context, MediaAction.AppleTv)?.component)
+    }
+
+    @Test fun disabledTvEntryFallsBackToUsableRegularEntry() {
+        val regular = addLauncher(apple, "Regular", Intent.CATEGORY_LAUNCHER)
+        val tv = addLauncher(apple, "Tv", Intent.CATEGORY_LEANBACK_LAUNCHER)
+        context.packageManager.setComponentEnabledSetting(tv, PackageManager.COMPONENT_ENABLED_STATE_DISABLED, 0)
+        assertEquals(regular, MediaShortcuts.intent(context, MediaAction.AppleTv)?.component)
+    }
+
+    @Test fun existingSonyAppleTvVariantCanBeOpened() {
+        val tv = addLauncher("com.apple.atve.sony.appletv", "Tv", Intent.CATEGORY_LEANBACK_LAUNCHER)
+        assertEquals(tv, MediaShortcuts.intent(context, MediaAction.AppleTv)?.component)
+    }
+
+    @Test fun disabledApplicationIsNotReportedAsReady() {
+        addLauncher(MediaShortcuts.CLASH_PACKAGE, "Main", Intent.CATEGORY_LEANBACK_LAUNCHER)
+        context.packageManager.setApplicationEnabledSetting(MediaShortcuts.CLASH_PACKAGE, PackageManager.COMPONENT_ENABLED_STATE_DISABLED_USER, 0)
+        assertFalse(MediaShortcuts.status(context).clash)
+    }
+
+    @Test fun commandsAreExplicitAndIdempotentNotToggles() {
+        addControl()
+        for ((action, command) in listOf(MediaAction.StartClash to "START_CLASH", MediaAction.StopClash to "STOP_CLASH")) {
+            val intent = requireNotNull(MediaShortcuts.intent(context, action))
+            assertEquals(control, intent.component)
+            assertEquals("${MediaShortcuts.CLASH_PACKAGE}.action.$command", intent.action)
+            assertEquals(Intent.FLAG_ACTIVITY_NEW_TASK, intent.flags)
+            assertNull(intent.data)
+            assertNull(intent.extras)
+        }
+    }
+
+    @Test fun privateOrDisabledControlIsNeverInvoked() {
+        val info = addControl()
+        info.exported = false
+        assertNull(MediaShortcuts.intent(context, MediaAction.StartClash))
+        info.exported = true
+        context.packageManager.setComponentEnabledSetting(control, PackageManager.COMPONENT_ENABLED_STATE_DISABLED, 0)
+        assertNull(MediaShortcuts.intent(context, MediaAction.StopClash))
+    }
+
+    @Test fun permissionProtectedControlIsNotReportedAsUsable() {
+        addControl().permission = "test.permission.PRIVATE_CONTROL"
+        assertNull(MediaShortcuts.intent(context, MediaAction.StartClash))
+    }
+
+    @Test fun anUnrelatedHandlerCannotReceiveClashCommands() {
+        val component = addLauncher("test.other.vpn", "Control", Intent.CATEGORY_LAUNCHER)
+        pm.addIntentFilterForActivity(component, IntentFilter("${MediaShortcuts.CLASH_PACKAGE}.action.START_CLASH"))
+        assertNull(MediaShortcuts.intent(context, MediaAction.StartClash))
+    }
+
+    @Test fun aLaunchableClientWithoutControlApiStillOpensNormally() {
+        val component = addLauncher(MediaShortcuts.CLASH_PACKAGE, "Main", Intent.CATEGORY_LEANBACK_LAUNCHER)
+        assertTrue(MediaShortcuts.status(context).clash)
+        assertEquals(component, MediaShortcuts.intent(context, MediaAction.Clash)?.component)
+        assertNull(MediaShortcuts.intent(context, MediaAction.StartClash))
+    }
+
+    private fun addControl() = pm.addActivityIfNotPresent(control).apply {
+        enabled = true; exported = true; applicationInfo.enabled = true
+    }
+
+    private fun addLauncher(pkg: String, name: String, category: String): ComponentName {
+        val component = ComponentName(pkg, "$pkg.$name")
+        pm.addActivityIfNotPresent(component).apply {
+            enabled = true; exported = true; applicationInfo.enabled = true
+        }
+        pm.addIntentFilterForActivity(component, IntentFilter(Intent.ACTION_MAIN).apply { addCategory(category) })
+        return component
+    }
+}
