diff --git a/app/src/main/java/app/orchard/tv/BeginnerActivity.kt b/app/src/main/java/app/orchard/tv/BeginnerActivity.kt
new file mode 100644
index 0000000000000000000000000000000000000000..660faf456daef3f64bca3dd1cce293d5dd8d49a2
--- /dev/null
+++ b/app/src/main/java/app/orchard/tv/BeginnerActivity.kt
@@ -0,0 +1,151 @@
+package app.orchard.tv
+
+import android.content.Intent
+import android.os.Bundle
+import android.widget.Toast
+import androidx.activity.ComponentActivity
+import androidx.activity.compose.BackHandler
+import androidx.activity.compose.setContent
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.text.BasicText
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.focus.FocusRequester
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.unit.Density
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import androidx.core.view.WindowCompat
+import androidx.core.view.WindowInsetsCompat
+import app.orchard.tv.guard.GuardSetup
+import app.orchard.tv.settings.BeginnerSetup
+import app.orchard.tv.settings.AerialSettings
+import app.orchard.tv.settings.Restricted
+import app.orchard.tv.system.SystemProbe
+import app.orchard.tv.ui.home.MenuRow
+import app.orchard.tv.ui.theme.Glyph
+import app.orchard.tv.ui.theme.Type
+import app.orchard.tv.ui.theme.canvasDensity
+
+/** Remote-first setup and recovery. It never grants permissions or installs other apps. */
+class BeginnerActivity : ComponentActivity() {
+    private var revision by mutableIntStateOf(0)
+
+    override fun onResume() { super.onResume(); revision++ }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        AerialSettings.init(this)
+        Restricted.init(this)
+        if (AerialSettings.locked || Restricted.active) {
+            finish()
+            return
+        }
+        WindowCompat.setDecorFitsSystemWindows(window, false)
+        WindowCompat.getInsetsController(window, window.decorView).hide(WindowInsetsCompat.Type.systemBars())
+        BeginnerSetup.rememberOriginalHome(this)
+        setContent {
+            val density = Density(canvasDensity(resources.displayMetrics), LocalDensity.current.fontScale)
+            CompositionLocalProvider(LocalDensity provides density) {
+                var page by remember { mutableIntStateOf(if (BeginnerSetup.completed(this)) 1 else 0) }
+                val authorized = remember(revision) { BeginnerSetup.authorized(this) }
+                val guardPage = remember { SystemProbe.guardSettingsIntent(this) }
+                val first = remember(page) { FocusRequester() }
+                LaunchedEffect(page, authorized) { withFrameNanos { }; runCatching { first.requestFocus() } }
+                BackHandler {
+                    when (page) { 0 -> finish(); 1 -> page = 0; else -> page = 1 }
+                }
+                Row(Modifier.fillMaxSize().background(Color(0xFF101621)).padding(44.dp), horizontalArrangement = Arrangement.spacedBy(40.dp)) {
+                    Column(Modifier.weight(1f)) {
+                        BasicText(stringResource(R.string.beginner_title), style = Type.Body.copy(fontSize = 30.sp))
+                        Spacer(Modifier.height(20.dp))
+                        BasicText(stringResource(R.string.beginner_intro), style = Type.Body)
+                        Spacer(Modifier.height(24.dp))
+                        BasicText(BeginnerSetup.deviceSummary(), style = Type.Caption)
+                        Spacer(Modifier.height(16.dp))
+                        BasicText(stringResource(R.string.beginner_compatibility), style = Type.Caption)
+                        Spacer(Modifier.height(16.dp))
+                        BasicText(BuildConfig.VERSION_NAME, style = Type.Caption)
+                    }
+                    Column(Modifier.weight(1f).fillMaxHeight().verticalScroll(rememberScrollState())) {
+                        when (page) {
+                            0 -> {
+                                BasicText(stringResource(R.string.beginner_detected), style = Type.Body)
+                                Spacer(Modifier.height(16.dp))
+                                BasicText(stringResource(R.string.beginner_remote), style = Type.Caption)
+                                Spacer(Modifier.height(24.dp))
+                                MenuRow(Glyph.Shield, stringResource(R.string.beginner_continue), focusRequester = first, onClick = { page = 1 })
+                                MenuRow(Glyph.ChevronLeft, stringResource(R.string.beginner_exit), onClick = { finish() })
+                            }
+                            1 -> {
+                                BasicText(stringResource(R.string.beginner_guard_title), style = Type.Body)
+                                Spacer(Modifier.height(12.dp))
+                                BasicText(stringResource(if (authorized) R.string.beginner_authorized else R.string.beginner_guard_body), style = Type.Caption)
+                                Spacer(Modifier.height(16.dp))
+                                if (authorized) {
+                                    MenuRow(Glyph.Check, stringResource(R.string.beginner_enter), focusRequester = first, onClick = {
+                                        BeginnerSetup.finish(this@BeginnerActivity)
+                                        GuardSetup.ensureEnabled(this@BeginnerActivity)
+                                        enterHome()
+                                    })
+                                } else if (guardPage != null) {
+                                    MenuRow(Glyph.Shield, stringResource(R.string.beginner_authorize), focusRequester = first, onClick = {
+                                        BeginnerSetup.prepareGuard(this@BeginnerActivity)
+                                        open(guardPage)
+                                    })
+                                } else {
+                                    BasicText(stringResource(R.string.beginner_missing_page), style = Type.Caption)
+                                    Spacer(Modifier.height(12.dp))
+                                }
+                                MenuRow(Glyph.Play, stringResource(R.string.beginner_try_without),
+                                    focusRequester = if (!authorized && guardPage == null) first else null,
+                                    onClick = { BeginnerSetup.disableGuard(this@BeginnerActivity); enterHome() })
+                                MenuRow(Glyph.Gear, stringResource(R.string.beginner_recovery), onClick = { page = 2 })
+                                MenuRow(Glyph.ChevronLeft, stringResource(R.string.beginner_back), onClick = { page = 0 })
+                            }
+                            else -> {
+                                BasicText(stringResource(R.string.beginner_recovery), style = Type.Body)
+                                Spacer(Modifier.height(12.dp))
+                                BasicText(stringResource(R.string.beginner_recovery_body), style = Type.Caption)
+                                Spacer(Modifier.height(16.dp))
+                                MenuRow(Glyph.Shield, stringResource(R.string.beginner_disable), focusRequester = first, onClick = {
+                                    BeginnerSetup.disableGuard(this@BeginnerActivity)
+                                    revision++
+                                    Toast.makeText(this@BeginnerActivity, R.string.beginner_disabled, Toast.LENGTH_LONG).show()
+                                })
+                                BeginnerSetup.originalHomeIntent(this@BeginnerActivity)?.let { intent ->
+                                    MenuRow(Glyph.Play, stringResource(R.string.beginner_stock_home), onClick = {
+                                        BeginnerSetup.disableGuard(this@BeginnerActivity); open(intent); finish()
+                                    })
+                                }
+                                BeginnerSetup.homeSettingsIntent(this@BeginnerActivity)?.let { intent ->
+                                    MenuRow(Glyph.Gear, stringResource(R.string.beginner_home_settings), onClick = {
+                                        BeginnerSetup.disableGuard(this@BeginnerActivity); open(intent)
+                                    })
+                                }
+                                MenuRow(Glyph.Gear, stringResource(R.string.beginner_tv_settings), onClick = { open(SystemProbe.settingsIntent(this@BeginnerActivity)) })
+                                MenuRow(Glyph.ChevronLeft, stringResource(R.string.beginner_back), onClick = { page = 1 })
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    private fun open(intent: Intent) {
+        runCatching { startActivity(intent) }.onFailure {
+            Toast.makeText(this, R.string.beginner_open_failed, Toast.LENGTH_LONG).show()
+        }
+    }
+
+    private fun enterHome() {
+        startActivity(Intent(this, MainActivity::class.java))
+        finish()
+    }
+}
