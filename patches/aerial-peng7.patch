+package app.orchard.tv.settings
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+import android.provider.Settings
+import app.orchard.tv.BuildConfig
+import app.orchard.tv.guard.GuardSetup
+import app.orchard.tv.guard.HomeGuardService
+
+/** Local onboarding choices, separate from the system's accessibility authorization. */
+object BeginnerSetup {
+    private const val PREFS = "beginner_setup"
+    private const val COMPLETE = "complete"
+    private const val GUARD = "guard_requested"
+    private const val ORIGINAL_HOME = "original_home"
+    private fun prefs(context: Context) = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    fun completed(context: Context): Boolean = prefs(context).getBoolean(COMPLETE, false)
+    fun guardRequested(context: Context): Boolean = prefs(context).getBoolean(GUARD, true)
+    fun needsGuide(context: Context): Boolean = BuildConfig.LOCAL_EDITION && !completed(context)
+
+    // A fresh APK must not enable privileged recovery before the owner finishes setup.
+    // Legacy upstream behavior is unchanged outside this custom edition.
+    fun mayRestoreGuard(context: Context): Boolean = !BuildConfig.LOCAL_EDITION ||
+        (GuardSetup.isUserUnlocked(context) && completed(context) && guardRequested(context))
+
+    fun rememberOriginalHome(context: Context) {
+        if (prefs(context).contains(ORIGINAL_HOME)) return
+        val intent = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME)
+        val info = context.packageManager.resolveActivity(intent, PackageManager.MATCH_DEFAULT_ONLY)?.activityInfo
+        if (info != null && info.packageName != context.packageName && info.packageName != "android" &&
+            info.exported && info.enabled) {
+            prefs(context).edit().putString(ORIGINAL_HOME, ComponentName(info.packageName, info.name).flattenToString()).commit()
+        }
+    }
+
+    fun authorized(context: Context): Boolean {
+        val component = ComponentName(context, HomeGuardService::class.java)
+        val pm = context.packageManager
+        if (pm.getComponentEnabledSetting(component) == PackageManager.COMPONENT_ENABLED_STATE_DISABLED) return false
+        if (Settings.Secure.getInt(context.contentResolver, Settings.Secure.ACCESSIBILITY_ENABLED, 0) != 1) return false
+        return Settings.Secure.getString(context.contentResolver, Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES)
+            .orEmpty().split(':').any { ComponentName.unflattenFromString(it) == component }
+    }
+
+    /** Re-enable only our own component. The system still owns the permission prompt. */
+    fun prepareGuard(context: Context) {
+        prefs(context).edit().putBoolean(GUARD, true).commit()
+        context.packageManager.setComponentEnabledSetting(ComponentName(context, HomeGuardService::class.java),
+            PackageManager.COMPONENT_ENABLED_STATE_DEFAULT, PackageManager.DONT_KILL_APP)
+    }
+
+    fun finish(context: Context) {
+        check(authorized(context)) { "Accessibility authorization is still required" }
+        prefs(context).edit().putBoolean(COMPLETE, true).putBoolean(GUARD, true).commit()
+    }
+
+    /** Stop only our service; never rewrite another app's accessibility settings. */
+    fun disableGuard(context: Context) {
+        prefs(context).edit().putBoolean(COMPLETE, true).putBoolean(GUARD, false).commit()
+        context.packageManager.setComponentEnabledSetting(ComponentName(context, HomeGuardService::class.java),
+            PackageManager.COMPONENT_ENABLED_STATE_DISABLED, PackageManager.DONT_KILL_APP)
+    }
+
+    fun originalHomeIntent(context: Context): Intent? {
+        val component = prefs(context).getString(ORIGINAL_HOME, null)?.let(ComponentName::unflattenFromString) ?: return null
+        val intent = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME).setComponent(component)
+        val info = runCatching { context.packageManager.getActivityInfo(component, 0) }.getOrNull()
+        return intent.takeIf { info != null && info.enabled && info.exported && info.packageName != context.packageName }
+    }
+
+    fun homeSettingsIntent(context: Context): Intent? = Intent(Settings.ACTION_HOME_SETTINGS)
+        .takeIf { context.packageManager.resolveActivity(it, 0) != null }
+
+    fun deviceSummary(): String = "${Build.MANUFACTURER} ${Build.MODEL}\nAndroid ${Build.VERSION.RELEASE} / API ${Build.VERSION.SDK_INT}\n${Build.SUPPORTED_ABIS.joinToString() }"
+}
